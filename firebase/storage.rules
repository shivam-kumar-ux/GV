rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // ── Public read for all website assets ──────────────────────────────────
    // Images, PDFs, and other static files served on the public website
    // are readable by anyone (no auth required).
    allow read: if true;

    // ── Write (upload) — authenticated admin staff only ─────────────────────
    // Only signed-in users (approved admin portal staff) may upload files.
    // Firestore-level approval is enforced at login; token presence is the
    // minimum bar we check here.
    allow write: if request.auth != null;
  }
}
