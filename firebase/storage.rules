rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isManagedSite(sitePrefix) {
      return sitePrefix == 'gv-shahpur'
        || sitePrefix == 'gv-t-dam'
        || sitePrefix == 'gv-pyq';
    }

    // Public website pages must be able to display uploaded images/PDFs.
    allow read: if true;

    // Admin uploads: allow any signed-in user to write under managed site prefixes.
    // The broader write permission (not splitting create/update) avoids the known
    // Firebase Storage resumable-upload finalization bug where request.auth can be
    // evaluated as null at the completion step even though the token is valid.
    match /{sitePrefix}/{allPaths=**} {
      allow write: if request.auth != null
        && isManagedSite(sitePrefix);
    }
  }
}
