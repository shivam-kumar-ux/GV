rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isManagedSite(sitePrefix) {
      return sitePrefix == 'gv-shahpur'
        || sitePrefix == 'gv-t-dam'
        || sitePrefix == 'gv-pyq';
    }

    // Public website pages must be able to display uploaded images/PDFs.
    allow read: if true;

    // Admin uploads are written below gv-shahpur, gv-t-dam, or gv-pyq.
    // Firestore rules still control who can save website content after upload.
    // File type/size are validated by the admin client before upload; keeping
    // Storage rules focused on auth + managed folders avoids blocking resumable
    // browser uploads before metadata is available.
    match /{sitePrefix}/{allPaths=**} {
      allow create, update: if request.auth != null
        && isManagedSite(sitePrefix);
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
