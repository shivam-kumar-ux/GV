rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all website assets
    allow read: if true;

    // Allow any authenticated user to write anywhere.
    // Security is enforced at the Firestore level (only approved staff
    // can update siteContent documents). Storage is not the place to
    // restrict which staff can upload — keeping it simple prevents the
    // storage/unauthorized error caused by resumable-upload finalization
    // auth checks on the newer .firebasestorage.app bucket domain.
    allow write: if request.auth != null;
  }
}
