rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all website assets (images, PDFs shown on public site)
    allow read: if true;

    // Allow any authenticated user to write — security is enforced at
    // the Firestore level (only approved staff can save siteContent).
    allow write: if request.auth != null;
  }
}
