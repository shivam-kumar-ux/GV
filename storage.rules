rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAllowedContentType() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    function isAllowedSize() {
      return request.resource != null && request.resource.size < 15 * 1024 * 1024; // 15MB
    }

    // Public files are readable by everyone.
    allow read: if true;

    // Authenticated users can upload/modify files under gv-* prefixes.
    // The admin panel itself already enforces approved-staff access via
    // Firestore rules + client-side auth checks, so we only need to verify
    // the user is signed in, the path is valid, and the file is safe.
    // NOTE: The previous firestore.get() cross-service lookup was causing
    // "storage/unauthorized" errors due to region/latency issues.
    match /{sitePrefix}/{folder}/{fileName} {
      allow write: if request.auth != null
        && sitePrefix.matches('gv-[a-z0-9-]+')
        && isAllowedContentType()
        && isAllowedSize();
    }

    // Default deny for any other paths.
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}