rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isManagedSite(sitePrefix) {
      return sitePrefix == 'gv-shahpur'
        || sitePrefix == 'gv-t-dam'
        || sitePrefix == 'gv-pyq';
    }

    function isAllowedContentType() {
      return request.resource != null
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
    }

    function isAllowedSize() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024;
    }

    // Public website pages must be able to display uploaded images/PDFs.
    allow read: if true;

    // Admin uploads are written below gv-shahpur, gv-t-dam, or gv-pyq.
    // Firestore rules still control who can save website content after upload.
    match /{sitePrefix}/{allPaths=**} {
      allow create, update: if request.auth != null
        && isManagedSite(sitePrefix)
        && isAllowedContentType()
        && isAllowedSize();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
